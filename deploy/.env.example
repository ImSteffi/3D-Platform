# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Write values WITHOUT quotes: Docker keeps quote marks as part of the value.

# The address the platform runs on (its DNS A record must point at this server).
DOMAIN=app.example.com

# Database. The admin user runs migrations; the app user is what the app uses day to day.
DATABASE_NAME=platform
DATABASE_ADMIN_USERNAME=platform_admin
DATABASE_ADMIN_PASSWORD=change-me-long-random
# Must be backend_db_user: the migrations grant rights to that name.
DATABASE_USERNAME=backend_db_user
DATABASE_PASSWORD=change-me-long-random

# Cloudflare R2: a production bucket and a token limited to it.
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET_NAME=thymos-3d-prod
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# World Labs Atlas (spatial context). Set a monthly spend limit in the Atlas project.
WLT_API_KEY=
